      "@mxm-editor/extension-ordered-list": ["packages/extension-ordered-list/src/index.ts"],
      "@mxm-editor/extension-task-item": ["packages/extension-task-item/src/index.ts"],
      "@mxm-editor/extension-task-list": ["packages/extension-task-list/src/index.ts"],
      "@mxm-editor/extension-text": ["packages/extension-text/src/index.ts"],
      "@mxm-editor/extension-heading": ["packages/extension-heading/src/index.ts"],
      "@mxm-editor/extension-bold": ["packages/extension-bold/src/index.ts"],
      "@mxm-editor/extension-italic": ["packages/extension-italic/src/index.ts"],
