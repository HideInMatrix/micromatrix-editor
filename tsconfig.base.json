      "@mxm-editor/extension-highlight": ["packages/extension-highlight/src/index.ts"],
      "@mxm-editor/extension-image": ["packages/extension-image/src/index.ts"],
      "@mxm-editor/extension-focus": ["packages/extension-focus/src/index.ts"],
      "@mxm-editor/extension-paragraph": ["packages/extension-paragraph/src/index.ts"],
      "@mxm-editor/extension-placeholder": ["packages/extension-placeholder/src/index.ts"],
      "@mxm-editor/extension-subscript": ["packages/extension-subscript/src/index.ts"],
      "@mxm-editor/extension-superscript": ["packages/extension-superscript/src/index.ts"],
      "@mxm-editor/extension-table": ["packages/extension-table/src/index.ts"],
      "@mxm-editor/extension-text-style": ["packages/extension-text-style/src/index.ts"],
