{
  "name": "@mxm-editor/static-renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./json/html-string": "./src/json/html-string/index.ts",
    "./json/react": "./src/json/react/index.ts",
    "./pm/html-string": "./src/pm/html-string/index.ts",
